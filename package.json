{
  "name": "open-design-bot",
  "version": "0.1.0",
  "description": "Contributor recognition bot for nexu-io/open-design — auto-calculates points, tiers, and posts upgrade cards on PR merges.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "ping": "tsx scripts/ping.ts",
    "test:render": "tsx scripts/test-render.ts",
    "preview": "tsx scripts/preview-pr.ts",
    "post-test": "tsx scripts/post-test.ts",
    "report:cards": "tsx scripts/contributor-card-funnel-report.ts",
    "report:x": "tsx scripts/x-share-report.ts",
    "report:dashboard": "tsx scripts/contributor-card-dashboard.ts",
    "report:all": "pnpm run report:cards && pnpm run report:x && pnpm run report:dashboard",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@octokit/auth-app": "^7.1.5",
    "@octokit/core": "^6.1.4",
    "@octokit/webhooks": "^13.4.3",
    "@resvg/resvg-js": "^2.6.2",
    "@resvg/resvg-wasm": "^2.6.2",
    "hono": "^4.6.14",
    "octokit": "^4.0.3",
    "react": "^19.2.6",
    "satori": "^0.12.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
